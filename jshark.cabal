cabal-version: 2.2
name:
  jshark
version:
  0.1
synopsis:
  Safe Javascript EDSL
homepage:
  https://github.com/goolord/jshark
bug-reports:
  https://github.com/goolord/jshark/issues
license:
  BSD-3-Clause
license-file:
  LICENSE
author:
  goolord
  chessai
  Andrew Martin
maintainer:
  goolord <zacharyachurchill@gmail.com>
  chessai <chessai1996@gmail.com>
  Andrew Martin <andrew.thaddeus@gmail.com>
  Kyle McKean <mckean.kylej@gmail.com>
copyright:
  copyright 2019 goolord
  copyright 2019 chessai
  copyright 2019 Andrew Martin
  copyright 2019 Kyle McKean
category:
  Language
build-type:
  Simple
extra-source-files:
  README.md
  CHANGELOG.md

library
  exposed-modules:
    JShark
    JShark.Api
    JShark.Array
    JShark.Console
    JShark.Json
    JShark.Math
    JShark.Promise
    JShark.Storage
    JShark.String
    JShark.Timers
    JShark.Types
    JShark.Ajax
    JShark.Object
    JShark.Dom
    JShark.Rec
    JShark.Compiler
  other-modules:
    JShark.Example
  build-depends:
    , base >= 4.14 && < 5
    , text >= 1.2 && < 2.2
    , pretty >= 1.1 && < 1.2
    , http-types >= 0.12 && < 0.13
    , bytestring >= 0.10 && < 0.13
    , containers >= 0.6 && < 0.9
    , directory >= 1.3 && < 1.4
    , filepath >= 1.4 && < 1.6
    , process >= 1.6 && < 1.7
  hs-source-dirs:
    src
  default-language:
    Haskell2010
  ghc-options:
    -Wall
    -O2

test-suite jshark-test
  type:
    exitcode-stdio-1.0
  main-is:
    Main.hs
  hs-source-dirs:
    test
  build-depends:
    , base
    , jshark
    , tasty
    , tasty-hunit
    , text
    , directory
    , filepath
  default-language:
    Haskell2010
  ghc-options:
    -Wall
