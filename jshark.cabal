cabal-version: 2.2
name:
  jshark
version:
  0.1
synopsis:
  Safe Javascript EDSL
homepage:
  https://github.com/goolord/jshark
bug-reports:
  https://github.com/goolord/jshark/issues
license:
  BSD-3-Clause
license-file:
  LICENSE
author:
  goolord
  chessai
  Andrew Martin
maintainer:
  goolord <zacharyachurchill@gmail.com>
  chessai <chessai1996@gmail.com>
  Andrew Martin <andrew.thaddeus@gmail.com>
  Kyle McKean <mckean.kylej@gmail.com>
copyright:
  copyright 2019 goolord
  copyright 2019 chessai
  copyright 2019 Andrew Martin
  copyright 2019 Kyle McKean
category:
  Language
build-type:
  Simple
extra-source-files:
  README.md
  CHANGELOG.md
data-files:
  examples/static/*.png
  examples/static/*.js
  examples/static/*.css
  examples/Life/js/LUTGenerator.js
  examples/Life/js/LifeSimd.js
  examples/Life/js/EngineWorker.js
  examples/Life/js/Main.js
  examples/Life/js/life-simd.wasm

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  exposed-modules:
    JShark
    JShark.Api
    JShark.Array
    JShark.Classes
    JShark.Console
    JShark.Json
    JShark.Map
    JShark.Math
    JShark.Promise
    JShark.Set
    JShark.Storage
    JShark.String
    JShark.Timers
    JShark.Worker
    JShark.Types
    JShark.Ajax
    JShark.Object
    JShark.Params
    JShark.Prim
    JShark.Dom
    JShark.Canvas
    JShark.Generic
    JShark.Rec
    JShark.Regex
    JShark.Compiler
    JShark.Bun
    JShark.Bun.Internal
  other-modules:
    JShark.Ir
  build-depends:
    , base >= 4.17 && < 5
    , text >= 1.2 && < 3
    , prettyprinter >= 1.7 && < 2
    , http-types >= 0.8 && < 1
    , bytestring >= 0.10.8 && < 1
    , containers >= 0.5 && < 1
    , directory >= 1.2.7 && < 2
    , filepath >= 1.4 && < 2
    , process >= 1.2 && < 2
  hs-source-dirs:
    src
  default-language:
    Haskell2010
  ghc-options:
    -O2

-- JShark.Lucid destructures Lucid.Base's Attribute, which is not part of
-- the public Lucid API, so the bound is the tested minor rather than the
-- next major: a rename inside 2.x would break the build.
common lucid-dep
  build-depends:
    lucid >= 2.11 && < 2.12

library jshark-lucid
  import: warnings, lucid-dep
  exposed-modules:
    JShark.Lucid
  build-depends:
    , base
    , jshark
    , text
  hs-source-dirs:
    jshark-lucid
  default-language:
    Haskell2010

common example-lib
  import: warnings, lucid-dep
  default-language:
    Haskell2010
  build-depends:
    , base
    , jshark
    , text

library breakout
  import: example-lib
  exposed-modules:
    Breakout
  other-modules:
    Client
    Page
    Types
  hs-source-dirs:
    examples/Breakout

library synth
  import: example-lib
  exposed-modules:
    Synth
  other-modules:
    Audio
    Client
    Keys
    Page
  hs-source-dirs:
    examples/Synth

library todo-mvc
  import: example-lib
  build-depends:
    jshark-lucid
  exposed-modules:
    TodoMvc
  other-modules:
    Client
    Ids
    Page
  hs-source-dirs:
    examples/TodoMvc

library life
  import: example-lib
  build-depends:
    , array
    , jshark-lucid
  exposed-modules:
    Life
    Grid
    LifeTestSupport
    Engine
    Patterns
    Types
    WorkerBridge
  other-modules:
    Catalog
    Client
    Discover
    Names
    Page
  hs-source-dirs:
    examples/Life

executable examples
  import: warnings, lucid-dep
  main-is:
    Main.hs
  other-modules:
    DevServer
    Paths_jshark
    SourcePane
  autogen-modules:
    Paths_jshark
  hs-source-dirs:
    examples/server
  build-depends:
    , base
    , breakout
    , directory >= 1.3 && < 2
    , filepath
    , jshark
    , life
    , scotty >= 0.20 && < 1
    , synth
    , text
    , todo-mvc
  default-language:
    Haskell2010
  ghc-options:
    -threaded

test-suite jshark-test
  import: warnings, lucid-dep
  type:
    exitcode-stdio-1.0
  main-is:
    Main.hs
  other-modules:
    Support
    BunTests
    LucidTests
    ExampleTests
    LifeTests
  hs-source-dirs:
    test
  build-depends:
    , base
    , async
    , breakout
    , jshark
    , jshark-lucid
    , life
    , synth
    , todo-mvc
    , tasty
    , tasty-hunit
    , text
    , directory >= 1.3 && < 2
    , filepath
    , process
  default-language:
    Haskell2010
  ghc-options:
    -Wno-deprecations
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-M10G

common bench
  import: warnings
  default-language: Haskell2010
  ghc-options:
    -O2
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-M10G
    -Wno-unused-do-bind
  build-depends:
    , base
    , deepseq >= 1.4 && < 1.6
    , jshark
    , tasty-bench >= 0.3.5 && < 0.5
    , text

-- Synthetic compiler paths (AST constructor matrix + Life-shaped kernels).
-- Does not compile full examples; use jshark-compiler-examples for that.
--
--   cabal bench jshark-compiler
--   cabal bench jshark-compiler -- jshark-compiler -p 'stages/lifeStep'
--   cabal bench jshark-compiler -- jshark-compiler -p 'codepaths/effect/lifeMedium'
benchmark jshark-compiler
  import: bench
  type: exitcode-stdio-1.0
  main-is:
    Compiler.hs
  other-modules:
    Stages
  hs-source-dirs:
    bench
  build-depends:
    , life

-- Full example programs (whole AST). Life codegen is slow — run only when
-- measuring that path:
--
--   cabal bench jshark-compiler-examples -- jshark-compiler-examples -p life
benchmark jshark-compiler-examples
  import: bench
  type: exitcode-stdio-1.0
  main-is:
    Examples.hs
  other-modules:
    Stages
  hs-source-dirs:
    bench
  build-depends:
    , breakout
    , life
    , synth
    , todo-mvc

executable print-size
  import: bench
  main-is:
    PrintSize.hs
  hs-source-dirs:
    bench
  build-depends:
    , life

benchmark jshark-forced
  import: bench
  type: exitcode-stdio-1.0
  main-is:
    Forced.hs
  hs-source-dirs:
    bench
  build-depends:
    , life

benchmark jshark-synthetic
  import: bench
  type: exitcode-stdio-1.0
  main-is:
    Synthetic.hs
  hs-source-dirs:
    bench
  other-modules:
    Stages
  build-depends:
    , jshark

benchmark jshark-lucid-bench
  import: bench, lucid-dep
  type: exitcode-stdio-1.0
  main-is:
    LucidBench.hs
  hs-source-dirs:
    bench
  build-depends:
    , jshark
    , jshark-lucid
