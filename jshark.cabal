    Page
  hs-source-dirs:
    examples/Hvm2Demo

executable build-hvm2-demo-wasm
  import: warnings
  main-is:
    BuildWasm.hs
  other-modules:
    Kernels
  hs-source-dirs:
    examples/Hvm2Demo
  build-depends:
    , base
    , directory
    , filepath
    , jshark
    , process
    , text
  default-language:
    Haskell2010

executable examples
  import: warnings, lucid-dep, llvm
  main-is:
    Main.hs
  other-modules:
    DevServer
    Paths_jshark
    SourcePane
  autogen-modules:
    Paths_jshark
  hs-source-dirs:
    examples/server
  build-depends:
    , base
    , breakout
    , directory
    , example-theme
    , filepath
    , hvm2-demo
    , jshark
    , life
    , scotty >= 0.20 && < 1
    , wai >= 3.2 && < 3.3
    , warp >= 3.3 && < 3.6
    , synth
    , text
    , todo-mvc
  default-language:
    Haskell2010
  ghc-options:
    -threaded
    -with-rtsopts=-N

test-suite jshark-test
  import: warnings, lucid-dep
  type:
    exitcode-stdio-1.0
  main-is:
    Main.hs
  other-modules:
    CaptureStderr
    Support
    BunTests
    CatalogTests
    LucidTests
    ExampleTests
    LifeTests
    LifeWorkerTests
    StaticCssTests
    PerfTests
    Hvm2Tests
    BindgenTests
    BindgenToy
  hs-source-dirs:
    test
  build-depends:
    , base
    , async
    , breakout
    , hvm2-demo
    , jshark
    , bindgen
    , jshark-lucid
    , life
    , synth
    , todo-mvc
    , tasty
    , tasty-hunit
    , text
    , directory
    , filepath
    , containers
    , process
  default-language:
    Haskell2010
  ghc-options:
    -Wno-deprecations
    -threaded
    -rtsopts
    -with-rtsopts=-N1
    -with-rtsopts=-M10G

common bench
  import: warnings, llvm
  default-language: Haskell2010
  ghc-options:
    -O2
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-M10G
    -Wno-unused-do-bind
  build-depends:
    , base
    , deepseq >= 1.4
    , jshark
    , tasty-bench >= 0.3.5
    , text

-- Synthetic compiler paths (AST constructor matrix + Life-shaped kernels).
-- Does not compile full examples; use jshark-compiler-examples for that.
--
--   cabal bench jshark-compiler
--   cabal bench jshark-compiler -- jshark-compiler -p 'stages/lifeStep'
--   cabal bench jshark-compiler -- jshark-compiler -p 'codepaths/effect/lifeMedium'
benchmark jshark-compiler
  import: bench
  type: exitcode-stdio-1.0
  main-is:
    Compiler.hs
  other-modules:
    Stages
  hs-source-dirs:
    bench
  build-depends:
    , life

-- Full example programs (whole AST). Life codegen is slow — run only when
-- measuring that path:
--
--   cabal bench jshark-compiler-examples -- jshark-compiler-examples -p life
benchmark jshark-compiler-examples
  import: bench
  type: exitcode-stdio-1.0
  main-is:
    Examples.hs
  other-modules:
    Stages
  hs-source-dirs:
    bench
  build-depends:
    , breakout
    , life
    , synth
    , todo-mvc

