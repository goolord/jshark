cabal-version: 2.4
name:
  jshark
version:
  0.1
synopsis:
  Safe Javascript EDSL
homepage:
  https://github.com/goolord/jshark
bug-reports:
  https://github.com/goolord/jshark/issues
license:
  BSD-3-Clause
license-file:
  LICENSE
author:
  goolord
  chessai
  Andrew Martin
maintainer:
  goolord <zacharyachurchill@gmail.com>
  chessai <chessai1996@gmail.com>
  Andrew Martin <andrew.thaddeus@gmail.com>
  Kyle McKean <mckean.kylej@gmail.com>
copyright:
  copyright 2019 goolord
  copyright 2019 chessai
  copyright 2019 Andrew Martin
  copyright 2019 Kyle McKean
category:
  Language
build-type:
  Simple
extra-source-files:
  README.md
  CHANGELOG.md
  wasm/hvm2/build.zig
  wasm/hvm2/src/root.zig
  wasm/hvm2/README.md
  jshark-bindgen/extract.mjs
  jshark-bindgen/package.json
  jshark-bindgen/bun.lock
  test/fixtures/jshark-bindgen/*.d.ts
  test/fixtures/jshark-bindgen/*.js
  examples/static/*.png
  examples/static/*.js
  examples/static/*.css
  examples/static/pico/*.css
  examples/static/pico/VERSION
  examples/static/hvm2-demo.wasm
  examples/static/speed-highlight/**/*.js
  examples/static/speed-highlight/**/*.css
  examples/static/speed-highlight/**/*.ts
  examples/static/speed-highlight/**/*.map
  examples/static/speed-highlight/**/*.json
  examples/Life/js/catalog.js
  examples/Life/js/pixi.min.js
  examples/Life/js/EngineWorker.js
  examples/Life/shaders/cell.frag.glsl
data-files:
  examples/static/*.png
  examples/static/*.js
  examples/static/*.css
  examples/static/pico/*.css
  examples/static/pico/VERSION
  examples/static/hvm2-demo.wasm
  examples/static/speed-highlight/**/*.js
  examples/static/speed-highlight/**/*.css
  examples/static/speed-highlight/**/*.ts
  examples/static/speed-highlight/**/*.map
  examples/static/speed-highlight/**/*.json
  examples/Life/js/catalog.js
  examples/Life/js/pixi.min.js
  examples/Life/js/EngineWorker.js
  examples/Life/shaders/cell.frag.glsl
  jshark-bindgen/extract.mjs
  jshark-bindgen/package.json

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

common llvm
  if os(windows)
  else
    ghc-options:
      -fllvm
      -pgmlo
      opt-20
      -pgmlc
      llc-20

library
  import: warnings, llvm
  exposed-modules:
    JShark
    JShark.Api
    JShark.Api.Caller
    JShark.Array
    JShark.Api.Types
    JShark.Api.Params
    JShark.Api.Prim
    JShark.Api.Rec
    JShark.Api.Classes
    JShark.Api.Generic
    JShark.Console
    JShark.Json
    JShark.Map
    JShark.Math
    JShark.Promise
    JShark.Set
    JShark.Storage
    JShark.String
    JShark.Timers
    JShark.Worker
    JShark.Ajax
    JShark.Object
    JShark.Dom
    JShark.Canvas
    JShark.Regex
    JShark.Compiler
    JShark.Hvm2
    JShark.Compiler.Hvm2Lint
    JShark.Bun
    JShark.Bun.Internal
    JShark.FlatTest
    JShark.Compiler.CompileTiming
    JShark.HotReload.Core
    JShark.HotReload.Client
    JShark.HotReload.Wai
    JShark.HotReload.Watcher
  other-modules:
    JShark.Compiler.Binder
    JShark.Compiler.Emit
    JShark.Compiler.CompileProgress
    JShark.Compiler.CompileReport
    JShark.Compiler.CompileTerminal
    JShark.Compiler.Flat
    JShark.Compiler.FlatEnc
    JShark.Compiler.FlatSoA
    JShark.Compiler.FlatView
    JShark.Compiler.Ir
    JShark.Compiler.JsNum
    JShark.Compiler.JsShim
    JShark.Compiler.JsFormat
    JShark.Compiler.Process
    JShark.Compiler.EmitBend
    JShark.Compiler.Evaluate
    JShark.Compiler.Metadata
    JShark.Compiler.Flatten
    JShark.Compiler.Lower
    JShark.Compiler.Optimize
    JShark.Compiler.Optimize.Analysis
    JShark.Compiler.Optimize.Elim
    JShark.Compiler.Optimize.Fold
    JShark.Compiler.Optimize.Hvm2
    JShark.Compiler.Hoist
    JShark.Compiler.Hoist.Canonical
    JShark.Compiler.Codegen.Core
    JShark.Compiler.Codegen.Flat
    JShark.Compiler.Codegen.Phoas
  build-depends:
    , ansi-terminal >= 1.0
    , async >= 2.2 && < 2.4
    , base >= 4.17 && < 5
    , vector >= 0.12
    , text >= 1.2 && < 3
    -- 1.x required for GHC 9.14; 0.6.x pulls text-builder-dev (broken on 9.14).
    , text-builder >= 1.0 && < 1.1
    , http-types >= 0.8 && < 1
    , bytestring >= 0.10.8 && < 1
    , containers
    , atomic-primops >= 0.8 && < 0.9
    , mtl >= 2.2
    , effectful >= 2.5 && < 2.8
    , exceptions >= 0.10
    , directory
    , filepath
    , process
    , typed-process >= 0.2.11 && < 0.3
    , streaming-bytestring >= 0.3.0 && < 0.4
    , stm >= 2.5 && < 2.6
    , wai >= 3.2 && < 3.3
    , fsnotify >= 0.4 && < 0.5
    , time >= 1.12 && < 1.16
  hs-source-dirs:
    src
  default-language:
    Haskell2010
  ghc-options:
    -O2

-- JShark.Lucid destructures Lucid.Base's Attribute, which is not part of
-- the public Lucid API, so the bound is the tested minor rather than the
-- next major: a rename inside 2.x would break the build.
common lucid-dep
  build-depends:
    lucid >= 2.11 && < 2.12

library jshark-lucid
  import: warnings, lucid-dep
  exposed-modules:
    JShark.Lucid
    JShark.Lucid.HotReload
  build-depends:
    , base
    , jshark
    , text
  hs-source-dirs:
    jshark-lucid
  default-language:
    Haskell2010

-- Internal library for the jshark-bindgen binary and its tests.
-- Cabal forbids the same component name as executable jshark-bindgen.
library bindgen
  import: warnings
  exposed-modules:
    JShark.Bindgen
    JShark.Bindgen.Cli
    JShark.Bindgen.Ir
    JShark.Bindgen.Json
    JShark.Bindgen.Emit
    JShark.Bindgen.ParseDts
    JShark.Bindgen.ParseJs
    JShark.Bindgen.Extract
  hs-source-dirs:
    jshark-bindgen
  other-modules:
    Paths_jshark
  autogen-modules:
    Paths_jshark
  build-depends:
    , base
    , text
    , containers
    , directory
    , filepath
    , process
    , optparse-applicative >= 0.18
  default-language:
    Haskell2010

executable jshark-bindgen
  import: warnings
  main-is:
    Main.hs
  hs-source-dirs:
    jshark-bindgen/app
  build-depends:
    , base
    , bindgen
    , text
  default-language:
    Haskell2010

common example-lib
  import: warnings, lucid-dep, llvm
  default-language:
    Haskell2010
  build-depends:
    , base
    , containers
    , example-theme
    , jshark
    , text

library example-theme
  import: warnings, lucid-dep
  -- Shared head helpers for example Page.hs shells (lives at examples/ThemeHead.hs).
  exposed-modules:
    ThemeHead
  hs-source-dirs:
    examples
  build-depends:
    , base
    , jshark-lucid
    , text
  default-language:
