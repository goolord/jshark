cabal-version: 2.2
name:
  jshark
version:
  0.1
synopsis:
  Safe Javascript EDSL
homepage:
  https://github.com/goolord/jshark
bug-reports:
  https://github.com/goolord/jshark/issues
license:
  BSD-3-Clause
license-file:
  LICENSE
author:
  goolord
  chessai
  Andrew Martin
maintainer:
  goolord <zacharyachurchill@gmail.com>
  chessai <chessai1996@gmail.com>
  Andrew Martin <andrew.thaddeus@gmail.com>
  Kyle McKean <mckean.kylej@gmail.com>
copyright:
  copyright 2019 goolord
  copyright 2019 chessai
  copyright 2019 Andrew Martin
  copyright 2019 Kyle McKean
category:
  Language
build-type:
  Simple
extra-source-files:
  README.md
  CHANGELOG.md
data-files:
  examples/static/*.png
  examples/static/*.js
  examples/static/*.css

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  exposed-modules:
    JShark
    JShark.Api
    JShark.Array
    JShark.Console
    JShark.Json
    JShark.Math
    JShark.Promise
    JShark.Storage
    JShark.String
    JShark.Timers
    JShark.Types
    JShark.Ajax
    JShark.Object
    JShark.Dom
    JShark.Canvas
    JShark.Generic
    JShark.Rec
    JShark.Regex
    JShark.Compiler
  build-depends:
    , base >= 4.14 && < 5
    , text >= 1.2 && < 3
    , pretty >= 1.1 && < 2
    , http-types >= 0.8 && < 1
    , bytestring >= 0.10.8 && < 1
    , containers >= 0.5 && < 1
    , directory >= 1.2.4 && < 2
    , filepath >= 1.4 && < 2
    , process >= 1.2 && < 2
  hs-source-dirs:
    src
  default-language:
    Haskell2010
  ghc-options:
    -O2

common example-lib
  import: warnings
  default-language:
    Haskell2010
  build-depends:
    , base
    , jshark
    , lucid >= 2.9 && < 3
    , text

library breakout
  import: example-lib
  exposed-modules:
    Breakout
  other-modules:
    Client
    Page
    Types
  hs-source-dirs:
    examples/Breakout

library todo-mvc
  import: example-lib
  exposed-modules:
    TodoMvc
  other-modules:
    Client
    Ids
    Page
  hs-source-dirs:
    examples/TodoMvc

executable examples
  import: warnings
  main-is:
    Main.hs
  other-modules:
    DevServer
    Paths_jshark
    SourcePane
  autogen-modules:
    Paths_jshark
  hs-source-dirs:
    examples/server
  build-depends:
    , base
    , breakout
    , directory >= 1.3 && < 2
    , filepath
    , jshark
    , lucid >= 2.9 && < 3
    , scotty >= 0.20 && < 1
    , text
    , todo-mvc
  default-language:
    Haskell2010
  ghc-options:
    -threaded

test-suite jshark-test
  import: warnings
  type:
    exitcode-stdio-1.0
  main-is:
    Main.hs
  other-modules:
    Support
    BunTests
  hs-source-dirs:
    test
  build-depends:
    , base
    , jshark
    , tasty
    , tasty-hunit
    , text
    , directory >= 1.3 && < 2
    , filepath
    , process
  default-language:
    Haskell2010
