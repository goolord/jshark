    Client
    Page
  hs-source-dirs:
    examples/Synth

library todo-mvc
  import: example-lib
  build-depends:
    jshark-lucid
  exposed-modules:
    TodoMvc
  other-modules:
    Client
    Ids
    Page
  hs-source-dirs:
    examples/TodoMvc

library life
  import: example-lib
  build-depends:
    , array
    , jshark-lucid
  exposed-modules:
    Life
    Grid
    GridApi
    LifeTestSupport
    Engine
    Patterns
    Types
    DiscoverCore
    LutCore
    Lut
    EngineFinish
    EngineWorker
  other-modules:
