packages:
  packages/jshark
  packages/jshark-testing
  packages/jshark-lucid
  packages/jshark-bindgen
  packages/jshark-hotreload
  examples

tests: True
benchmarks: True
optimization: 2

-- Warning flags live in each package's own `common warnings` stanza
-- (the Hackage-safe location); this file only carries environment
-- specifics.

-- Windows lacks the LLVM opt/llc-20 toolchain used elsewhere.
if !os(windows)
  package *
    ghc-options:
      -fllvm
      -pgmlo opt-20
      -pgmlc llc-20

-- Hackage scotty-0.30 still caps containers < 0.8 (blocks GHC 9.14 boot
-- containers-0.8). Drop this pin once a release allows containers >= 0.8.
source-repository-package
  type: git
  location: https://github.com/scotty-web/scotty.git
  tag: b5f4dfbdbd6c94f3d21492ac7925e699c3b54e87
