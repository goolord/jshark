packages:
  packages/jshark
  packages/jshark-lucid
  packages/jshark-bindgen
  packages/jshark-hotreload
  examples

tests: True
benchmarks: True
optimization: 2

-- Warning flags live in each package's own `common warnings` stanza
-- (the Hackage-safe location); this file only carries environment
-- specifics. `-Werror` is opt-in via each package's `werror` flag so
-- released packages stay buildable on future GHCs; developer builds enable
-- it here.
package jshark
  flags: +werror
package jshark-lucid
  flags: +werror
package jshark-bindgen
  flags: +werror
package jshark-hotreload
  flags: +werror
package jshark-examples
  flags: +werror

-- Windows lacks the LLVM opt/llc-20 toolchain used elsewhere.
if !os(windows)
  package *
    ghc-options:
      -fllvm
      -pgmlo opt-20
      -pgmlc llc-20

-- Hackage scotty-0.30 still caps containers < 0.8 (blocks GHC 9.14 boot
-- containers-0.8). The released library packages already allow containers
-- < 0.9, so only this monorepo's examples build is pinned; drop this once a
-- scotty release allows containers >= 0.8.
source-repository-package
  type: git
  location: https://github.com/scotty-web/scotty.git
  tag: b5f4dfbdbd6c94f3d21492ac7925e699c3b54e87
