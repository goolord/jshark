cabal-version: 3.4

-- jshark-examples: the showcase apps, dev server, offline compiler,
-- tests, and benchmarks.
name: jshark-examples
version: 0.1.0.0
synopsis: JShark example apps, dev server, and static exporter
description:
  The JShark showcase applications (Breakout, TodoMVC, Synth, Life),
  the live-reloading development server, the static site exporter, and
  the offline compiler. Distributed from the JShark repository rather
  than as a library.
homepage: https://github.com/goolord/jshark
bug-reports: https://github.com/goolord/jshark/issues
license: BSD-3-Clause
license-file: LICENSE
author: goolord
maintainer: goolord <zacharyachurchill@gmail.com>
category: Language
build-type: Simple
tested-with: GHC == 9.14.1
extra-source-files:
  static/**/*.js
  static/**/*.css
  static/**/*.png
  static/**/*.map
  static/**/*.json
  static/**/*.ts
  static/pico/VERSION
  src/JShark/Example/Life/js/*.js
  src/JShark/Example/Life/shaders/*.glsl

data-files:
  static/**/*.js
  static/**/*.css
  static/**/*.png
  static/**/*.map
  static/**/*.json
  static/**/*.ts
  static/pico/VERSION
  src/JShark/Example/Life/js/*.js
  src/JShark/Example/Life/shaders/*.glsl

source-repository head
  type: git
  location: https://github.com/goolord/jshark

flag werror
  description: Treat warnings as errors (development builds)
  manual: True
  default: False

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  if flag(werror)
    ghc-options: -Werror

-- Lucid destructures Lucid.Base internals; see packages/jshark-lucid.
common lucid-dep
  build-depends:
    lucid >= 2.11 && < 2.12

library
  import: warnings, lucid-dep
  exposed-modules:
    JShark.Example.Breakout
    JShark.Example.Breakout.Client
    JShark.Example.Breakout.Page
    JShark.Example.Breakout.Types
    JShark.Example.Life
    JShark.Example.Life.Catalog
    JShark.Example.Life.Client
    JShark.Example.Life.Discover
    JShark.Example.Life.DiscoverCore
    JShark.Example.Life.DiscoverRuntime
    JShark.Example.Life.Engine
    JShark.Example.Life.EngineFinish
    JShark.Example.Life.EngineWorker
    JShark.Example.Life.Grid
    JShark.Example.Life.GridApi
    JShark.Example.Life.LifeTestSupport
    JShark.Example.Life.Lut
    JShark.Example.Life.LutBoot
    JShark.Example.Life.LutCore
    JShark.Example.Life.Names
    JShark.Example.Life.Page
    JShark.Example.Life.Palette
    JShark.Example.Life.Patterns
    JShark.Example.Life.Pixi
    JShark.Example.Life.Profile
    JShark.Example.Life.Types
    JShark.Example.Registry
    JShark.Example.Synth
    JShark.Example.Synth.Audio
    JShark.Example.Synth.Client
    JShark.Example.Synth.Keys
    JShark.Example.Synth.Page
    JShark.Example.Theme
    JShark.Example.TodoMvc
    JShark.Example.TodoMvc.Client
    JShark.Example.TodoMvc.Ids
    JShark.Example.TodoMvc.Page
    JShark.Example.Watch
  build-depends:
    , array
    , base
    , containers
    , directory
    , filepath
    , jshark
    , jshark-hotreload
    , jshark-lucid
    , process
    , text
  hs-source-dirs: src
  default-language: Haskell2010

executable jshark-examples
  import: warnings, lucid-dep
  main-is: Main.hs
  other-modules:
    DevServer
    Paths_jshark_examples
    Recompile
    SourcePane
  autogen-modules:
    Paths_jshark_examples
  hs-source-dirs: app/server
  build-depends:
    , base
    , bytestring
    , directory
    , filepath
    , jshark
    , jshark-examples
    , jshark-hotreload
    , lucid
    , process
    , scotty >= 0.20 && < 1
    , stm
    , text
    , warp >= 3.3 && < 3.6
  default-language: Haskell2010
  ghc-options:
    -threaded
    -with-rtsopts=-N

executable jshark-compile
  import: warnings, lucid-dep
  main-is: Main.hs
  hs-source-dirs: app/compile
  build-depends:
    , base
    , bytestring
    , directory
    , filepath
    , jshark
    , jshark-examples
    , lucid
    , text
  default-language: Haskell2010
  ghc-options:
    -threaded
    -with-rtsopts=-N

executable gen-life-catalog
  import: warnings
  main-is: GenCatalog.hs
  hs-source-dirs: app/life-tools
  build-depends:
    , base
    , jshark-examples
    , text
  default-language: Haskell2010

executable gen-life-worker
  import: warnings
  main-is: GenLifeWorker.hs
  hs-source-dirs: app/life-tools
  build-depends:
    , base
    , jshark-examples
    , text
  default-language: Haskell2010

-- Life compiler profiling tools (manual runs, not CI-gated).
common bench
  import: warnings
  default-language: Haskell2010
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-M10G
    -Wno-unused-do-bind

executable jshark-life-phases
  import: bench
  main-is: LifePhases.hs
  hs-source-dirs: bench
  build-depends:
    , base
    , bytestring
    , jshark
    , jshark-examples
    , text

executable jshark-life-full-emit
  import: bench
  main-is: LifeFullEmit.hs
  hs-source-dirs: bench
  build-depends:
    , base
    , deepseq >= 1.4
    , jshark
    , jshark-examples
    , jshark:testing
    , tasty-bench >= 0.3.5
    , text

executable jshark-life-emit
  import: bench
  main-is: LifeEmit.hs
  hs-source-dirs: bench
  build-depends:
    , base
    , deepseq >= 1.4
    , jshark
    , jshark-examples
    , jshark:testing
    , tasty-bench >= 0.3.5
    , text

executable jshark-probe
  import: bench
  main-is: Probe.hs
  hs-source-dirs: bench
  build-depends:
    , base
    , bytestring
    , jshark
    , jshark-examples
    , text


benchmark jshark-examples-bench
  import: bench
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: bench
  build-depends:
    , base
    , deepseq >= 1.4
    , jshark
    , jshark-examples
    , jshark:testing
    , tasty-bench >= 0.3.5
    , text

benchmark jshark-forced
  import: bench
  type: exitcode-stdio-1.0
  main-is: Forced.hs
  hs-source-dirs: bench
  build-depends:
    , base
    , jshark
    , jshark-examples
    , tasty-bench >= 0.3.5

test-suite jshark-examples-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    BunGate
    BunTests
    CatalogTests
    ExampleTests
    LifeTests
    LifeWorkerTests
    Paths_jshark_examples
    PerfTests
    StaticCssTests
  autogen-modules:
    Paths_jshark_examples
  hs-source-dirs: test
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , jshark
    , jshark-examples
    , jshark:testing
    , process
    , tasty
    , tasty-hunit
    , text
  default-language: Haskell2010
  ghc-options:
    -Wno-deprecations
    -threaded
    -rtsopts
    -with-rtsopts=-N1
    -with-rtsopts=-M10G
