cabal-version: 3.4

-- jshark-lucid: Lucid HTML DSL integration.
name: jshark-lucid
version: 0.1.0.0
synopsis: Lucid HTML templates that render to JShark DOM builders
description:
  Write declarative HTML with Lucid syntax and compile it to JShark DOM
  builders (@createElement@, attribute writes, and event bindings) that
  run in the browser or under a headless DOM.
homepage: https://github.com/goolord/jshark
bug-reports: https://github.com/goolord/jshark/issues
license: BSD-3-Clause
license-file: LICENSE
author: goolord
maintainer: goolord <zacharyachurchill@gmail.com>
category: Language
stability: experimental
build-type: Simple
tested-with: GHC == 9.14.1
extra-doc-files:
  README.md
  CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/goolord/jshark

flag werror
  description: Treat warnings as errors (development builds)
  manual: True
  default: False

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  if flag(werror)
    ghc-options: -Werror

-- JShark.Lucid destructures Lucid.Base's Attribute, which is not part of
-- the public Lucid API, so the bound is the tested minor rather than the
-- next major: a rename inside 2.x would break the build.
common lucid-dep
  build-depends:
    lucid >= 2.11 && < 2.12

library
  import: warnings, lucid-dep
  exposed-modules:
    JShark.Lucid
    JShark.Lucid.HotReload
  build-depends:
    , base >= 4.17 && < 5
    , jshark >= 0.1 && < 0.2
    , text >= 1.2 && < 3
  hs-source-dirs: src
  default-language: Haskell2010

test-suite jshark-lucid-test
  import: warnings, lucid-dep
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
    , base
    , directory >= 1.3 && < 1.4
    , jshark
    , jshark-lucid
    , lucid
    , tasty >= 1.4 && < 1.6
    , tasty-hunit >= 0.10 && < 0.11
    , text >= 1.2 && < 3
  default-language: Haskell2010
  ghc-options:
    -Wno-deprecations
    -threaded
    -rtsopts
    -with-rtsopts=-N1
    -with-rtsopts=-M4G

benchmark jshark-lucid-bench
  import: warnings, lucid-dep
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: bench
  build-depends:
    , base
    , bytestring >= 0.10.8 && < 0.13
    , jshark
    , jshark-lucid
    , lucid
    , text >= 1.2 && < 3
  default-language: Haskell2010
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-M4G
