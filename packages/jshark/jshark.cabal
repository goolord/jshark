cabal-version: 3.4

-- jshark core: safe JS EDSL + compiler pipeline.
name: jshark
version: 0.1.0.0
synopsis: Safe Javascript EDSL
description:
  A typed, readable JavaScript EDSL embedded in Haskell. Programs are
  ordinary Haskell values: binders use PHOAS, statements compose with
  @do@ notation, and codegen emits clean JavaScript whose binder names
  and callstack hints are preserved.
  .
  The API separates pure expressions (@Expr@) from side effects
  (@Effect@). Pure terms can be evaluated directly in Haskell, and
  effectful programs run under Bun or a browser with optional
  @happy-dom@ globals.
homepage: https://github.com/goolord/jshark
bug-reports: https://github.com/goolord/jshark/issues
license: BSD-3-Clause
license-file: LICENSE
author:
  goolord
  chessai
  Andrew Martin
maintainer:
  goolord <zacharyachurchill@gmail.com>
  chessai <chessai1996@gmail.com>
  Andrew Martin <andrew.thaddeus@gmail.com>
  Kyle McKean <mckean.kylej@gmail.com>
copyright:
  copyright 2019 goolord
  copyright 2019 chessai
  copyright 2019 Andrew Martin
  copyright 2019 Kyle McKean
category: Language
stability: experimental
build-type: Simple
tested-with: GHC == 9.14.1
extra-doc-files:
  README.md
  CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/goolord/jshark

flag werror
  description: Treat warnings as errors (development builds)
  manual: True
  default: False

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  if flag(werror)
    ghc-options: -Werror

library
  import: warnings
  exposed-modules:
    JShark
    JShark.Api
    JShark.Api.Caller
    JShark.Api.Classes
    JShark.Api.Generic
    JShark.Api.Params
    JShark.Api.Rec
    JShark.Api.Types
    JShark.Prelude
    JShark.Ajax
    JShark.Array
    JShark.Bun
    JShark.Bun.Internal
    JShark.Canvas
    JShark.Compiler
    JShark.Compiler.Codegen.Core
    JShark.Compiler.CompileProgress
    JShark.Compiler.CompileTiming
    JShark.Compiler.Flat
    JShark.Compiler.Ir
    JShark.Console
    JShark.Dom
    JShark.Json
    JShark.Map
    JShark.Math
    JShark.Object
    JShark.Promise
    JShark.Regex
    JShark.Set
    JShark.Storage
    JShark.String
    JShark.Timers
    JShark.Worker
  other-modules:
    -- compiler internals: compiled with the library but not exposed
    -- (the JShark facade and JShark.Compiler carry the public surface)
    JShark.Api.Prim
    JShark.Compiler.Binder
    JShark.Compiler.Codegen.Flat
    JShark.Compiler.Codegen.Stmt
    JShark.Compiler.Emit
    JShark.Compiler.Evaluate
    JShark.Compiler.JsFormat
    JShark.Compiler.JsNum
    JShark.Compiler.JsShim
    JShark.Compiler.Lower
    JShark.Compiler.Process
  build-depends:
    , ansi-terminal >= 1.0 && < 1.2
    , async >= 2.2 && < 2.4
    , atomic-primops >= 0.8 && < 0.9
    , base >= 4.17 && < 5
    , bytestring >= 0.10.8 && < 0.13
    , containers >= 0.6 && < 0.8
    , directory >= 1.3 && < 1.4
    , effectful >= 2.5 && < 2.8
    , filepath >= 1.4 && < 1.6
    , http-types >= 0.8 && < 1
    , mtl >= 2.2 && < 2.4
    , transformers >= 0.5 && < 0.7
    , process >= 1.6 && < 1.7
    , streaming-bytestring >= 0.3.0 && < 0.4
    , text >= 1.2 && < 3
    -- 1.x required for GHC 9.14; 0.6.x pulls text-builder-dev (broken on 9.14).
    , text-builder >= 1.0 && < 1.1
    , typed-process >= 0.2.11 && < 0.3
    , vector >= 0.12 && < 0.14
  hs-source-dirs: src
  default-language: Haskell2010

-- | Shared test/bench support. Public so the example package (which
-- cannot depend on a private component) can reuse it; this is not a
-- user-facing API and may change without notice.
library testing
  import: warnings
  visibility: public
  exposed-modules:
    Bench.Stages
    CaptureStderr
    Test.Support
  hs-source-dirs: test-support
  build-depends:
    , base >= 4.17 && < 5
    , deepseq >= 1.4 && < 1.6
    , jshark
    , tasty >= 1.4 && < 1.6
    , tasty-bench >= 0.3.5 && < 0.4
    , tasty-hunit >= 0.10 && < 0.11
    , text >= 1.2 && < 3
  default-language: Haskell2010

test-suite jshark-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    FlatTest
  hs-source-dirs: test
  build-depends:
    , base
    , directory >= 1.3 && < 1.4
    , filepath >= 1.4 && < 1.6
    , jshark
    , jshark:testing
    , tasty >= 1.4 && < 1.6
    , tasty-hunit >= 0.10 && < 0.11
    , text >= 1.2 && < 3
    , vector >= 0.12 && < 0.14
  default-language: Haskell2010
  ghc-options:
    -Wno-deprecations
    -threaded
    -rtsopts
    -with-rtsopts=-N1
    -with-rtsopts=-M10G

benchmark jshark-compiler
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: bench
  build-depends:
    , base
    , deepseq >= 1.4 && < 1.6
    , jshark
    , jshark:testing
    , tasty-bench >= 0.3.5 && < 0.4
    , text >= 1.2 && < 3
  default-language: Haskell2010
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-M10G
