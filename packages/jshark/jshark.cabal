cabal-version: 3.4

-- jshark core: the typed JS AST, its EDSL surface, and the compiler.
name: jshark
version: 0.1.0.0
synopsis: Safe Javascript EDSL
description:
  A typed, readable JavaScript EDSL embedded in Haskell. Programs are
  ordinary Haskell values: binders use PHOAS, statements compose with
  @do@ notation, and codegen emits clean JavaScript whose binder names
  and callstack hints are preserved.

  The API separates pure expressions (@Expr@) from side effects
  (@Effect@). Pure terms can be evaluated directly in Haskell. Platform
  bindings (DOM, canvas, arrays, timers, …), build tooling, and the Bun
  test runner live in @jshark-base@.
homepage: https://github.com/goolord/jshark
bug-reports: https://github.com/goolord/jshark/issues
license: BSD-3-Clause
license-file: LICENSE
author:
  goolord
  chessai
  Andrew Martin
maintainer:
  goolord <zacharyachurchill@gmail.com>
  chessai <chessai1996@gmail.com>
  Andrew Martin <andrew.thaddeus@gmail.com>
  Kyle McKean <mckean.kylej@gmail.com>
copyright:
  copyright 2019 goolord
  copyright 2019 chessai
  copyright 2019 Andrew Martin
  copyright 2019 Kyle McKean
category: Language
stability: experimental
build-type: Simple
tested-with: GHC == 9.14.1
extra-doc-files:
  README.md
  CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/goolord/jshark

flag werror
  description: Treat warnings as errors (development builds)
  manual: True
  default: False

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  if flag(werror)
    ghc-options: -Werror

library
  import: warnings
  exposed-modules:
    JShark
    JShark.Api
    JShark.Api.Params
    JShark.Api.Rec
    JShark.Api.Syntax
    JShark.Api.Types
    JShark.Internal
    JShark.Object
  other-modules:
    -- Compiler internals; tests and tooling reach them through
    -- 'JShark.Internal'.
    JShark.Compiler.Codegen
    JShark.Compiler.Emit
    JShark.Compiler.Evaluate
    JShark.Compiler.Ir
    JShark.Compiler.Lower
  build-depends:
    , base >= 4.17 && < 5
    , bytestring >= 0.10.8 && < 0.13
    , containers >= 0.6 && < 0.9
    , mtl >= 2.2 && < 2.4
    , text >= 1.2 && < 3
  hs-source-dirs: src
  default-language: Haskell2010
