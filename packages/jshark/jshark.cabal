cabal-version: 2.4

-- jshark core: safe JS EDSL + compiler pipeline.
name: jshark
version: 0.1
synopsis: Safe Javascript EDSL
homepage: https://github.com/goolord/jshark
bug-reports: https://github.com/goolord/jshark/issues
license: BSD-3-Clause
license-file: LICENSE
author:
  goolord
  chessai
  Andrew Martin
maintainer:
  goolord <zacharyachurchill@gmail.com>
  chessai <chessai1996@gmail.com>
  Andrew Martin <andrew.thaddeus@gmail.com>
  Kyle McKean <mckean.kylej@gmail.com>
copyright:
  copyright 2019 goolord
  copyright 2019 chessai
  copyright 2019 Andrew Martin
  copyright 2019 Kyle McKean
category: Language
build-type: Simple
extra-source-files:
  README.md
  CHANGELOG.md

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  exposed-modules:
    JShark
    JShark.Api
    JShark.Api.Caller
    JShark.Api.Classes
    JShark.Api.Generic
    JShark.Api.Params
    JShark.Api.Rec
    JShark.Api.Types
    JShark.Prelude
    JShark.Ajax
    JShark.Array
    JShark.Bun
    JShark.Bun.Internal
    JShark.Canvas
    JShark.Compiler
    JShark.Compiler.Codegen.Core
    JShark.Compiler.CompileProgress
    JShark.Compiler.CompileTiming
    JShark.Compiler.Flat
    JShark.Compiler.Ir
    JShark.Console
    JShark.Dom
    JShark.Json
    JShark.Map
    JShark.Math
    JShark.Object
    JShark.Promise
    JShark.Regex
    JShark.Set
    JShark.Storage
    JShark.String
    JShark.Timers
    JShark.Worker
  other-modules:
    -- compiler internals: compiled with the library but not exposed
    -- (the JShark facade and JShark.Compiler carry the public surface)
    JShark.Api.Prim
    JShark.Compiler.Binder
    JShark.Compiler.Codegen.Flat
    JShark.Compiler.Codegen.Stmt
    JShark.Compiler.Emit
    JShark.Compiler.Evaluate
    JShark.Compiler.JsFormat
    JShark.Compiler.JsNum
    JShark.Compiler.JsShim
    JShark.Compiler.Lower
    JShark.Compiler.Process
  build-depends:
    , ansi-terminal >= 1.0
    , async >= 2.2 && < 2.4
    , atomic-primops >= 0.8 && < 0.9
    , base >= 4.17 && < 5
    , bytestring >= 0.10.8 && < 1
    , containers
    , directory
    , effectful >= 2.5 && < 2.8
    , exceptions >= 0.10
    , filepath
    , http-types >= 0.8 && < 1
    , mtl >= 2.2
    , transformers
    , process
    , streaming-bytestring >= 0.3.0 && < 0.4
    , text >= 1.2 && < 3
    -- 1.x required for GHC 9.14; 0.6.x pulls text-builder-dev (broken on 9.14).
    , text-builder >= 1.0 && < 1.1
    , time >= 1.12 && < 1.16
    , typed-process >= 0.2.11 && < 0.3
    , vector >= 0.12
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -O2

test-suite jshark-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    CaptureStderr
    FlatTest
    Support
  hs-source-dirs: test
  build-depends:
    , base
    , directory
    , filepath
    , jshark
    , tasty
    , tasty-hunit
    , text
    , vector
  default-language: Haskell2010
  ghc-options:
    -Wno-deprecations
    -threaded
    -rtsopts
    -with-rtsopts=-N1
    -with-rtsopts=-M10G

benchmark jshark-compiler
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    Stages
  hs-source-dirs: bench
  build-depends:
    , base
    , deepseq >= 1.4
    , jshark
    , tasty-bench >= 0.3.5
    , text
  default-language: Haskell2010
  ghc-options:
    -O2
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-M10G
