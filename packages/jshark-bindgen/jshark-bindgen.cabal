cabal-version: 2.4

-- jshark-bindgen: TypeScript/JS FFI generator (see packages/jshark-bindgen)
-- jshark-bindgen: TypeScript/JS FFI generator (see packages/jshark-bindgen)
name: jshark-bindgen
version: 0.1
synopsis: Generate Haskell FFI bindings from TypeScript declarations
homepage: https://github.com/goolord/jshark
bug-reports: https://github.com/goolord/jshark/issues
license: BSD-3-Clause
license-file: LICENSE
author: goolord
maintainer: goolord <zacharyachurchill@gmail.com>
category: Language
build-type: Simple
extra-source-files:
  extract.mjs
  package.json
  bun.lock

data-files:
  extract.mjs
  package.json
  bun.lock

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  exposed-modules:
    JShark.Bindgen
    JShark.Bindgen.Cli
    JShark.Bindgen.Ir
    JShark.Bindgen.Json
    JShark.Bindgen.Emit
    JShark.Bindgen.ParseDts
    JShark.Bindgen.ParseJs
    JShark.Bindgen.Extract
  autogen-modules:
    Paths_jshark_bindgen
  other-modules:
    Paths_jshark_bindgen
  hs-source-dirs: src
  build-depends:
    , base
    , containers
    , directory
    , filepath
    , optparse-applicative >= 0.18
    , process
    , text
  default-language: Haskell2010

executable jshark-bindgen
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    , base
    , jshark-bindgen
    , text
  default-language: Haskell2010

test-suite jshark-bindgen-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    BindgenToy
    BindgenTests
  hs-source-dirs: test
  build-depends:
    , base
    , containers
    , directory
    , filepath
    , jshark
    , jshark-bindgen
    , tasty
    , tasty-hunit
    , text
  default-language: Haskell2010
  ghc-options:
    -Wno-deprecations
    -threaded
    -rtsopts
    -with-rtsopts=-N1
    -with-rtsopts=-M4G
