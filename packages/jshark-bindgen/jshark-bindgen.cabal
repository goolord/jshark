cabal-version: 3.4

-- jshark-bindgen: TypeScript/JS FFI generator.
name: jshark-bindgen
version: 0.1.0.0
synopsis: Generate Haskell FFI bindings from TypeScript declarations
description:
  Extract typed Haskell @ffi@ wrappers from TypeScript @.d.ts@ or JSDoc
  declarations. Requires @bun@ with @typescript@ installed to run the
  extractor.
homepage: https://github.com/goolord/jshark
bug-reports: https://github.com/goolord/jshark/issues
license: BSD-3-Clause
license-file: LICENSE
author: goolord
maintainer: goolord <zacharyachurchill@gmail.com>
category: Language
stability: experimental
build-type: Simple
tested-with: GHC == 9.14.1
extra-doc-files:
  README.md
  CHANGELOG.md
extra-source-files:
  extract.mjs
  package.json
  bun.lock
  test/fixtures/jshark-bindgen/ms.d.ts
  test/fixtures/jshark-bindgen/plain.d.ts
  test/fixtures/jshark-bindgen/toy.d.ts
  test/fixtures/jshark-bindgen/toy.js
  test/BindgenToy.hs

data-files:
  extract.mjs
  package.json
  bun.lock
  test/fixtures/jshark-bindgen/ms.d.ts
  test/fixtures/jshark-bindgen/plain.d.ts
  test/fixtures/jshark-bindgen/toy.d.ts
  test/fixtures/jshark-bindgen/toy.js
  test/BindgenToy.hs

source-repository head
  type: git
  location: https://github.com/goolord/jshark

flag werror
  description: Treat warnings as errors (development builds)
  manual: True
  default: False

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  if flag(werror)
    ghc-options: -Werror

library
  import: warnings
  exposed-modules:
    JShark.Bindgen
    JShark.Bindgen.Cli
    JShark.Bindgen.Ir
    JShark.Bindgen.Json
    JShark.Bindgen.Emit
    JShark.Bindgen.Extract
  autogen-modules:
    Paths_jshark_bindgen
  other-modules:
    Paths_jshark_bindgen
  hs-source-dirs: src
  build-depends:
    , base >= 4.17 && < 5
    , containers >= 0.6 && < 0.8
    , directory >= 1.3 && < 1.4
    , filepath >= 1.4 && < 1.6
    , optparse-applicative >= 0.18 && < 0.19
    , process >= 1.6 && < 1.7
    , text >= 1.2 && < 3
  default-language: Haskell2010

executable jshark-bindgen
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    , base
    , jshark-bindgen
    , text >= 1.2 && < 3
  default-language: Haskell2010

test-suite jshark-bindgen-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    BindgenToy
    BindgenTests
    Paths_jshark_bindgen
  autogen-modules:
    Paths_jshark_bindgen
  hs-source-dirs: test
  build-depends:
    , base
    , containers >= 0.6 && < 0.8
    , directory >= 1.3 && < 1.4
    , filepath >= 1.4 && < 1.6
    , jshark
    , jshark-bindgen
    , tasty >= 1.4 && < 1.6
    , tasty-hunit >= 0.10 && < 0.11
    , text >= 1.2 && < 3
  default-language: Haskell2010
  ghc-options:
    -Wno-deprecations
    -threaded
    -rtsopts
    -with-rtsopts=-N1
    -with-rtsopts=-M4G
