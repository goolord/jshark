cabal-version: 3.4

-- jshark-hotreload: SSE hub, WAI middleware, and file watcher for the
-- example dev server (see packages/jshark-hotreload)
name: jshark-hotreload
version: 0.1.0.0
synopsis: Hot-reload infrastructure for JShark apps
description:
  Server-sent-events hub, WAI middleware, and filesystem watcher used by
  the JShark example development server to reload compiled modules in a
  live browser session. Independent of the @jshark@ compiler.
homepage: https://github.com/goolord/jshark
bug-reports: https://github.com/goolord/jshark/issues
license: BSD-3-Clause
license-file: LICENSE
author: goolord
maintainer: goolord <zacharyachurchill@gmail.com>
category: Language
stability: experimental
build-type: Simple
tested-with: GHC == 9.14.1
extra-doc-files:
  README.md
  CHANGELOG.md
extra-source-files:
  assets/jshark-reload.js

source-repository head
  type: git
  location: https://github.com/goolord/jshark

flag werror
  description: Treat warnings as errors (development builds)
  manual: True
  default: False

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  if flag(werror)
    ghc-options: -Werror

library
  import: warnings
  exposed-modules:
    JShark.HotReload.Core
    JShark.HotReload.Client
    JShark.HotReload.Wai
    JShark.HotReload.Watcher
  build-depends:
    , aeson >= 2.0 && < 2.4
    , base >= 4.17 && < 5
    , bytestring >= 0.10.8 && < 0.13
    , containers >= 0.6 && < 0.8
    , directory >= 1.3 && < 1.4
    , filepath >= 1.4 && < 1.6
    , fsnotify >= 0.4 && < 0.5
    , http-types >= 0.8 && < 1
    , streaming-bytestring >= 0.3.0 && < 0.4
    , stm >= 2.5 && < 2.6
    , template-haskell >= 2.16 && < 2.25
    , text >= 1.2 && < 3
    , time >= 1.12 && < 1.16
    , wai >= 3.2 && < 3.3
  hs-source-dirs: src
  default-language: Haskell2010

test-suite jshark-hotreload-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
    , base
    , bytestring >= 0.10.8 && < 0.13
    , directory >= 1.3 && < 1.4
    , filepath >= 1.4 && < 1.6
    , http-types >= 0.8 && < 1
    , jshark
    , jshark-hotreload
    , tasty >= 1.4 && < 1.6
    , tasty-hunit >= 0.10 && < 0.11
    , text >= 1.2 && < 3
    , wai >= 3.2 && < 3.3
  default-language: Haskell2010
  ghc-options:
    -Wno-deprecations
    -threaded
    -rtsopts
    -with-rtsopts=-N1
    -with-rtsopts=-M4G
