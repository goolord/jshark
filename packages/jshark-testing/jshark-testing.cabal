cabal-version: 2.4

-- jshark-testing: shared test/bench support modules (golden-case helpers,
-- stderr capture, compiler-stage benches). Depends on jshark; nothing in
-- the jshark library may depend on this package.
name: jshark-testing
version: 0.1
synopsis: Shared test and benchmark support for jshark
homepage: https://github.com/goolord/jshark
bug-reports: https://github.com/goolord/jshark/issues
license: BSD-3-Clause
license-file: LICENSE
author:
  goolord
  chessai
  Andrew Martin
maintainer:
  goolord <zacharyachurchill@gmail.com>
  chessai <chessai1996@gmail.com>
  Andrew Martin <andrew.thaddeus@gmail.com>
  Kyle McKean <mckean.kylej@gmail.com>
copyright:
  copyright 2019 goolord
  copyright 2019 chessai
  copyright 2019 Andrew Martin
  copyright 2019 Kyle McKean
category: Language
build-type: Simple

common warnings
  ghc-options:
    -Wall
    -Wextra
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  exposed-modules:
    Bench.Stages
    CaptureStderr
    Test.Support
  hs-source-dirs: test-support
  build-depends:
    , base >= 4.17 && < 5
    , deepseq >= 1.4
    , jshark
    , tasty
    , tasty-bench >= 0.3.5
    , tasty-hunit
    , text >= 1.2 && < 3
  default-language: Haskell2010
